# Keep the build context small and secret-free.
.git
.github
**/.env
**/.env.*
!**/.env.example
!**/.env.production.example

# Not needed by the backend image
mobile/
web/
docs/
terraform/
tests/
scripts/
data/
uploads/
docker/
*.db
*.dump
*.sqlite*

# Python / tooling caches
**/__pycache__/
**/*.pyc
**/.pytest_cache/
**/.mypy_cache/
**/.ruff_cache/
venv/
.venv/
**/node_modules/
