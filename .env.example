# ─────────────────────────────────────────────────────────────────────────────
# YatraSathi — environment template
# Copy this file to .env and fill in your values.
# .env is gitignored — never commit real secrets.
# ─────────────────────────────────────────────────────────────────────────────

# ── Database ──────────────────────────────────────────────────────────────────
# PostgreSQL with pgvector extension required
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/yatra_sathi

# ── LLM provider ─────────────────────────────────────────────────────────────
# Supported: groq | nvidia_nim
LLM_PROVIDER=groq
LLM_MODEL=llama-3.3-70b-versatile
LLM_MAX_TOKENS=4000
LLM_TEMPERATURE=0.3

# Groq — https://console.groq.com
GROQ_API_KEY=your_groq_api_key_here

# NVIDIA NIM (alternative) — https://build.nvidia.com
NVIDIA_NIM_API_KEY=your_nvidia_nim_api_key_here

# ── Routing ───────────────────────────────────────────────────────────────────
# Public OSRM instance used by default; point to a self-hosted instance for
# better reliability in production.
OSRM_URL=http://router.project-osrm.org/route/v1/driving

# ── Embeddings ────────────────────────────────────────────────────────────────
# sentence-transformers model name — must match the model used when the
# embeddings table was populated.
EMBEDDING_MODEL=all-MiniLM-L6-v2

# ── Optional ──────────────────────────────────────────────────────────────────
# DEBUG=false
# HOST=0.0.0.0
# PORT=8000
# JWT_SECRET_KEY=change-me-in-production
# OPENWEATHER_API_KEY=your_openweather_key_here
