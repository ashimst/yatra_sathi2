# ─────────────────────────────────────────────────────────────────────────────
# YatraSathi — environment template
# Copy this file to .env and fill in your values.
# .env is gitignored — never commit real secrets.
# ─────────────────────────────────────────────────────────────────────────────

# ── Database ──────────────────────────────────────────────────────────────────
# PostgreSQL with pgvector extension required
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/yatra_sathi

# ── LLM provider ─────────────────────────────────────────────────────────────
# Supported: groq | nvidia_nim
LLM_PROVIDER=groq
LLM_MODEL=llama-3.3-70b-versatile
LLM_MAX_TOKENS=4000
LLM_TEMPERATURE=0.3

# Groq — https://console.groq.com
GROQ_API_KEY=your_groq_api_key_here

# NVIDIA NIM (alternative) — https://build.nvidia.com
NVIDIA_NIM_API_KEY=your_nvidia_nim_api_key_here

# ── Routing ───────────────────────────────────────────────────────────────────
# Public OSRM instance used by default; point to a self-hosted instance for
# better reliability in production.
OSRM_URL=http://router.project-osrm.org/route/v1/driving

# ── Embeddings ────────────────────────────────────────────────────────────────
# sentence-transformers model name — must match the model used when the
# embeddings table was populated. Semantic search only considers vectors whose
# model_name equals this value. Keep in sync with backend/app/config/settings.py.
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5

# ── Optional ──────────────────────────────────────────────────────────────────
# DEBUG=false
# HOST=0.0.0.0
# PORT=8000
# ENVIRONMENT=development        # set to "production" in deployed environments
# JWT_SECRET_KEY=                # empty in dev -> fixed dev-only secret; required (32+ chars) in production
# CORS_ORIGINS=http://localhost:5173,http://localhost:3000
# ADMIN_EMAILS=you@example.com
# PUBLIC_BASE_URL=               # e.g. https://api.yatrasathi.com when web and API are on different origins
# OPENWEATHER_API_KEY=your_openweather_key_here
