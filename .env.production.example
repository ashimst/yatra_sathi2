# ==============================================================================
# YatraSathi Production Environment Configuration Template
# Copy this file to .env.production on your deployment server, or set these as
# secrets/env vars in your hosting platform. Never commit real values.
# ==============================================================================

# ── Application ───────────────────────────────────────────────────────────────
APP_NAME="YatraSathi Nepal"
APP_VERSION="1.0.0"
# Must be "production" (or "staging"): enables startup checks that refuse
# insecure defaults (missing/weak JWT secret, wildcard CORS, missing DB/LLM keys).
ENVIRONMENT=production
DEBUG=false
LOG_LEVEL=INFO
HOST=0.0.0.0
PORT=8000

# ── Cross-Origin Resource Sharing (CORS) ──────────────────────────────────────
# Comma-separated list of exact allowed origins. "*" is refused in production.
CORS_ORIGINS=https://yatrasathi.pages.dev,https://yatrasathi.com

# Public URL of this API; uploaded image URLs are returned as absolute URLs
# so the frontend (on another origin) can load them.
PUBLIC_BASE_URL=https://api.yatrasathi.com

# ── PostgreSQL Database with PostGIS & pgvector ────────────────────────────────
# Standard connection string format: postgresql://[user]:[password]@[host]:[port]/[dbname]
# For managed providers (Supabase, Neon, AWS RDS):
DATABASE_URL=postgresql://postgres:<your-db-password>@<db-host>:5432/yatra_sathi
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=5

# ── LLM & AI Engine ───────────────────────────────────────────────────────────
# Supported: groq | nvidia_nim
LLM_PROVIDER=groq
LLM_MODEL=llama-3.3-70b-versatile
LLM_TEMPERATURE=0.3
LLM_MAX_TOKENS=4000
GROQ_API_KEY=<your-groq-api-key>

# Optional: NVIDIA NIM API Key
# NVIDIA_NIM_API_KEY=<your-nvidia-nim-api-key>

# ── Authentication & Security ─────────────────────────────────────────────────
# Generate with: openssl rand -hex 32   (min 32 chars; the app refuses to start otherwise)
JWT_SECRET_KEY=<generate-with-openssl-rand-hex-32>
JWT_ALGORITHM=HS256
JWT_EXPIRE_HOURS=168

# Comma-separated emails allowed to perform admin actions (e.g. set place cover photos)
ADMIN_EMAILS=

# ── Rate limiting (per client IP) ─────────────────────────────────────────────
# memory:// is per-replica; use redis://host:6379 to share limits across replicas.
RATE_LIMIT_STORAGE_URI=memory://
RATE_LIMIT_DEFAULT=120/minute
RATE_LIMIT_AI=20/minute
RATE_LIMIT_AUTH=10/minute
RATE_LIMIT_UPLOAD=20/minute

# ── Embeddings ────────────────────────────────────────────────────────────────
# Must match the model used to generate the stored place vectors.
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5

# ── Routing Engine ────────────────────────────────────────────────────────────
# Public OSRM or private container/server
OSRM_URL=https://router.project-osrm.org
OSRM_TIMEOUT=15

# ── Frontend Environment Variable (Vite) ──────────────────────────────────────
# Set this in the Cloudflare Pages build environment.
# Points to your deployed FastAPI backend URL
# VITE_API_BASE_URL=https://api.yatrasathi.com
